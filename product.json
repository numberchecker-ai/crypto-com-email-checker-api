{
  "name": "Crypto.com Email Checker API",
  "brand": "NumberChecker",
  "repository": "numberchecker-ai/crypto-com-email-checker-api",
  "description": "Asynchronous bulk Crypto.com verification API for NumberChecker.",
  "official_site": "https://numberchecker.ai",
  "landing_page": "https://numberchecker.ai/products/crypto-com-email-checker",
  "canonical_docs": "https://docs.numberchecker.ai/crypto-email-checker",
  "base_url": "https://api.numberchecker.ai",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async",
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "format": "text",
    "one_per_line": true,
    "input_kind": "email"
  },
  "products": [
    {
      "type": "crypto_email",
      "name": "Email Checker",
      "min": 1,
      "max": 10000000,
      "fields": [
        "email",
        "activated"
      ],
      "product_id": 67,
      "min_billable_numbers": 2000,
      "available": true
    }
  ],
  "pricing_url": "https://numberchecker.ai/pricing",
  "maintainer": "NumberChecker",
  "license": "MIT",
  "last_reviewed": "2026-10-30"
}
